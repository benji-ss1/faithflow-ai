# Dockerfile for the PresentFlow document converter deployed to Fly.io.
# Runs only scripts/convert-server.ts — headless LibreOffice turns PPTX/PPT
# into PDF. TLS is terminated by Fly's edge on 443; this container listens on
# 3002 internally. No Next.js, no database, no S3 creds — it only converts.

FROM node:20-slim

# LibreOffice (headless) + a core font set so slide text renders with sane
# fallbacks. --no-install-recommends keeps the image lean; libreoffice-impress
# is the component that opens .pptx/.ppt. fonts-liberation covers Arial/Times
# metric-compatible fallbacks common in church decks.
RUN apt-get update \
  && apt-get install -y --no-install-recommends \
     libreoffice-impress \
     libreoffice-core \
     fonts-liberation \
     fonts-dejavu \
     fonts-crosextra-carlito \
     fonts-crosextra-caladea \
     fonts-noto-core \
     fonts-noto-color-emoji \
     fontconfig \
     ca-certificates \
  && fc-cache -f \
  && rm -rf /var/lib/apt/lists/*
# Carlito/Caladea are metric-compatible with Calibri/Cambria (PowerPoint's
# default fonts) so text wraps like the original; Noto core covers non-Latin
# scripts; Noto Color Emoji renders emoji. Adds roughly 150-200MB to the image.

WORKDIR /app

# The converter imports ONLY Node built-ins + its sibling scripts, so the sole
# runtime dependency is tsx (runs the TypeScript directly, as before). Install
# just that into a tiny standalone manifest — not the whole app's dependency
# tree (Next, Electron, sharp…), which bloated the image and its attack surface.
RUN npm init -y >/dev/null && npm install --no-audit --no-fund --ignore-scripts tsx@4.23.0

# The converter script + tsconfig (tsx transpiles TS on the fly).
COPY scripts/convert-server.ts scripts/convert-lib.ts scripts/convert-auth.ts scripts/convert-warmup.pptx ./scripts/
COPY tsconfig.json ./

ENV NODE_ENV=production
# Give LibreOffice a writable, isolated profile dir per container.
ENV HOME=/tmp
EXPOSE 3002

CMD ["npx", "tsx", "scripts/convert-server.ts"]
