# Dockerfile for the audio WebSocket bridge deployed to Fly.io.
# Runs only scripts/audio-server.ts — no Next.js server. TLS is terminated
# by Fly's edge proxy on 443; this container listens on 3001 internally.

FROM node:20-slim

WORKDIR /app

# Copy manifest first for cache efficiency
COPY package.json package-lock.json* ./
# --ignore-scripts skips lifecycle hooks (fast + safe for most deps),
# but that also skips sharp's install script which downloads the
# platform-specific prebuild binary. Without it, @xenova/transformers
# (used by semantic scripture fallback + phrase-cross-reference)
# crashes on every low-conf detection with "Cannot find native binding".
# Fix: after the ignore-scripts install, explicitly force-install the
# linux-x64 sharp binary. Uses npm's optional-dep machinery via
# --os/--cpu flags so we get the right prebuild regardless of the
# build host arch. `|| true` so a temporary sharp CDN blip doesn't
# fail the whole deploy — the bridge still works with sharp missing
# (rate-limited fallback logs kick in, primary regex detection is
# unaffected).
RUN npm ci --omit=dev --ignore-scripts \
  && npm i tsx \
  && npm install --os=linux --cpu=x64 --no-save sharp || true

# Copy source. We need:
#   - scripts/audio-server.ts
#   - src/lib/db/*         (Drizzle client + schema)
#   - src/lib/bible-parser.ts, song-parser.ts, command-parser.ts
#   - src/lib/server/bible.ts (semantic search)
#   - src/lib/embeddings.ts   (if referenced)
# Simplest: copy everything the script imports transitively.
COPY scripts ./scripts
COPY src ./src
COPY tsconfig.json ./
COPY drizzle.config.ts ./
# 2026-07-23: config/ holds Deepgram keyterm JSON (default + per-church
# overrides). Without this COPY, loadKeyterms() silently falls back to the
# 12-term hard-coded list in src/lib/deepgram-keyterms.ts. See default.json
# for the expanded 66-book + core-vocab list.
COPY config ./config

ENV NODE_ENV=production
EXPOSE 3001

# tsx handles TS transpile on the fly — no separate build step needed.
CMD ["npx", "tsx", "scripts/audio-server.ts"]
